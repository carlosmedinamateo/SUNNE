---
import { Image } from 'astro:assets';

// Importa aquí tus imágenes cuando las tengas
// import fotoIngles from '../../assets/images/foto_ingles.png';
// import fotoEspanol from '../../assets/images/foto_espanol.png';
import logosune from '../../assets/images/logo_1_7cm.png';
import españa from '../../assets/images/Flag_of_Spain.svg.webp';
import inglaterra from '../../assets/images/inglaterra.png';

const niveles = [
  { cod: "A1 - A2", nombre: "Básico / Inicial", desc: "Para quienes empiezan desde cero o quieren consolidar bases sólidas de vocabulario y gramática cotidiana." },
  { cod: "B1 - B2", nombre: "Intermedio / Autónomo", desc: "Preparación intensiva para desenvolverse con fluidez, escribir textos estructurados y superar exámenes oficiales." },
  { cod: "C1 - C2", nombre: "Avanzado / Dominio", desc: "Perfeccionamiento de la pronunciación, fluidez profesional, debates complejos y certificaciones superiores." },
];

const modalidades = [
  { icono: "👥", titulo: "Clases en Grupos Reducidos", desc: "Grupos de máximo 6 a 8 alumnos clasificados estrictamente por nivel para asegurar la máxima participación oral." },
  { icono: "🎯", titulo: "Clases Individuales (One-to-One)", desc: "Sesiones 100% personalizadas según tus objetivos específicos: entrevistas de trabajo, exámenes o conversación." },
  { icono: "🏆", titulo: "Preparación de Exámenes Oficiales", desc: "Cursos enfocados en técnicas de examen para titulaciones de Cambridge, Aptis, EOI o DELE en el caso de español." },
  { icono: "🗣️", titulo: "Talleres de Conversación", desc: "Sesiones dinámicas diseñadas exclusivamente para perder el miedo a hablar y ganar soltura de forma natural." },
  { icono: "💻", titulo: "Clases Online", desc: "Formación en directo desde donde quieras, con la misma interacción, flexibilidad y materiales que nuestras clases presenciales." },
];
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Oferta Formativa de Idiomas - SUNNE ACADEMY</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    </head>
    
    <body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen" style="font-family: 'Inter', sans-serif;">

        <!-- NAVBAR -->
        <nav class="bg-yellow-200 shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
        <a href="#inicio" class="flex items-center gap-3">
            <Image 
                src={logosune} 
                alt="Logo SUNNE ACADEMY" 
                class="h-30 w-auto object-contain"
            />
            
        </a>
        <div class="space-x-4">
            <a href="#galeria" class="text-sm text-slate-700 hover:text-blue-700">Galería</a>
            <a href="#contacto" class="text-sm text-slate-700 hover:text-blue-700">Contacto</a>
        </div>
    </div>
</nav>

        <main class="max-w-6xl mx-auto px-6 py-16 flex-grow space-y-20">

            <!-- HERO SECCIÓN -->
            <div class="text-center max-w-3xl mx-auto space-y-4">
                <span class="inline-flex items-center rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700 ring-1 ring-inset ring-orange-600/10">
                    Idiomas en San Cristóbal de La Laguna
                </span>
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-950 tracking-tight leading-tight">
                    Aprende <span class="text-orange-600">Inglés y Español</span> a tu ritmo
                </h1>
                <p class="text-lg text-slate-600">
                    Programas adaptados a todos los niveles del marco europeo (A1 a C2) con metodologías prácticas y atención centrada en el alumno.
                </p>
            </div>

            <!-- SECCIÓN 1: IDIOMAS QUE OFRECEMOS -->
            <section class="grid md:grid-cols-2 gap-8">
                
                <!-- Idioma: Inglés -->
                <div class="bg-white rounded-3xl shadow-lg border border-slate-100 overflow-hidden flex flex-col justify-between">
                   <Image 
    src={inglaterra} 
    alt="Clases de inglés" 
    class="w-full h-64 object-cover p-4 transition-transform duration-300 hover:scale-105"
/>
                    <div class="p-8 space-y-4">
                        <span class="text-xs font-bold uppercase tracking-wider text-orange-600">Formación Principal</span>
                        <h2 class="text-2xl font-bold text-slate-950">Clases de Inglés</h2>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Desde nivel principiante hasta preparación avanzada. Refuerzo escolar, inglés académico y preparación específica para exámenes oficiales (Cambridge, Aptis, EOI).
                        </p>
                    </div>
                </div>

                <!-- Idioma: Español -->
                <div class="bg-white rounded-3xl shadow-lg border border-slate-100 overflow-hidden flex flex-col justify-between">
                    <Image 
                     src={españa} 
                      alt="Clases de español" 
                      class="w-full h-64 object-cover p-4 transition-transform duration-300 hover:scale-105"
                    />
                    <div class="p-8 space-y-4">
                        <span class="text-xs font-bold uppercase tracking-wider text-orange-600">Spanish for Foreigners</span>
                        <h2 class="text-2xl font-bold text-slate-950">Clases de Español / ELE</h2>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Cursos de español para extranjeros dirigidos a estudiantes internacionales, residentes y profesionales que buscan adquirir fluidez oral y escrita rápida.
                        </p>
                    </div>
                </div>

            </section>

            <!-- SECCIÓN 2: NIVELES (A1 - C2) -->
            <section class="bg-white rounded-3xl shadow-xl border border-slate-100 p-8 md:p-12 space-y-8">
                <div class="text-center max-w-2xl mx-auto space-y-2">
                    <h2 class="text-3xl font-bold text-slate-950">Niveles según el Marco Europeo (MCER)</h2>
                    <p class="text-slate-600 text-sm">Evaluamos tu nivel inicial de forma gratuita antes de empezar.</p>
                </div>

                <div class="grid md:grid-cols-3 gap-6">
                    {niveles.map((n) => (
                        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 space-y-3">
                            <span class="inline-block bg-orange-100 text-orange-700 font-extrabold text-sm px-3 py-1 rounded-lg">
                                {n.cod}
                            </span>
                            <h3 class="font-bold text-slate-900 text-lg">{n.nombre}</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">{n.desc}</p>
                        </div>
                    ))}
                </div>
            </section>

            <!-- SECCIÓN 3: TIPOS DE CLASES Y MODALIDADES -->
            <!-- SECCIÓN 3: TIPOS DE CLASES Y MODALIDADES -->
<section class="space-y-8">
    <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-950">Modalidades de Clase</h2>
        <p class="text-slate-600 text-sm mt-2">Elige el formato que mejor se adapte a tus horarios y necesidades de aprendizaje.</p>
    </div>

    <!-- Rejilla con los primeros 4 elementos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {modalidades.slice(0, 4).map((m) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-start gap-4">
                <span class="text-3xl">{m.icono}</span>
                <div class="space-y-1">
                    <h3 class="font-bold text-slate-900 text-base">{m.titulo}</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">{m.desc}</p>
                </div>
            </div>
        ))}
    </div>

    <!-- Quinta tarjeta (Clases Online) centrada abajo -->
    {modalidades[4] && (
        <div class="flex justify-center">
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex items-start gap-4 w-full md:w-1/2">
                <span class="text-3xl">{modalidades[4].icono}</span>
                <div class="space-y-1">
                    <h3 class="font-bold text-slate-900 text-base">{modalidades[4].titulo}</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">{modalidades[4].desc}</p>
                </div>
            </div>
        </div>
    )}
</section>

            <!-- LLAMADA A LA ACCIÓN -->
            <section class="bg-slate-900 text-white rounded-3xl p-10 text-center space-y-6">
                <h2 class="text-3xl font-bold">¿No sabes cuál es tu nivel actual?</h2>
                <p class="text-slate-300 max-w-xl mx-auto text-sm">
                    Ven a conocernos o contáctanos por WhatsApp. Realizamos una prueba de nivel totalmente sin compromiso para ubicarte en el grupo ideal.
                </p>
                <div>
                    <a href="/#contacto" class="inline-block bg-orange-600 hover:bg-orange-500 text-white font-semibold px-8 py-4 rounded-xl transition shadow-lg">
                        Solicitar Prueba de Nivel
                    </a>
                </div>
            </section>

        </main>

        <!-- FOOTER -->
        <footer class="bg-slate-950 text-slate-400 py-8 text-center text-sm border-t border-slate-900">
            <p>&copy; SUNNE ACADEMY. Todos los derechos reservados.</p>
        </footer>

        <style>
            @import "tailwindcss";
        </style>

    </body>
</html>