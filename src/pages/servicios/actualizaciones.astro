---
import { Image } from 'astro:assets';

// Logo del navbar (ajusta la ruta si difiere)
import logosune from '../../assets/images/logo_1_7cm.png';

// Importa aquí las imágenes de los proyectos reales cuando las tengas
// import fotoSeptiembre from '../../assets/images/proyecto_septiembre.jpg';

// Lista de proyectos del mes para el curso escolar
const proyectosMes = [
  {
    mes: "Septiembre",
    titulo: "Proyecto de Bienvenida e Inmersión",
    estado: "completado", // 'activo', 'proximo', o 'completado'
    tag: "Inicio de Curso",
    descripcion: "Dinámicas de presentación, fijación de metas anuales y primeras actividades temáticas del curso.",
    imagen: null // Pon la variable importada cuando la tengas
  },
  {
    mes: "Octubre",
    titulo: "Próximamente / Coming Soon",
    estado: "activo",
    tag: "En Planificación",
    descripcion: "Estamos preparando un taller especial para este mes. Muy pronto revelaremos la temática.",
    imagen: null
  },
  {
    mes: "Noviembre",
    titulo: "Próximamente / Coming Soon",
    estado: "proximo",
    tag: "Proyecto Mensual",
    descripcion: "Actividad temática y retos dinámicos enfocados en reforzar vocabulario y trabajo en equipo.",
    imagen: null
  },
  {
    mes: "Diciembre",
    titulo: "Próximamente / Coming Soon",
    estado: "proximo",
    tag: "Especial Fin de Trimestre",
    descripcion: "Actividades de inmersión cultural y festividades de invierno adaptadas por niveles.",
    imagen: null
  },
  {
    mes: "Enero",
    titulo: "Próximamente / Coming Soon",
    estado: "proximo",
    tag: "Año Nuevo, Nuevos Retos",
    descripcion: "Arranque de nuevos objetivos trimestrales y preparación para las convocatorias de examen.",
    imagen: null
  },
  {
    mes: "Febrero",
    titulo: "Próximamente / Coming Soon",
    estado: "proximo",
    tag: "Proyecto Mensual",
    descripcion: "Taller interactivo de expresión oral y dinámicas colaborativas.",
    imagen: null
  },
  {
    mes: "Marzo",
    titulo: "Próximamente / Coming Soon",
    estado: "proximo",
    tag: "Proyecto Mensual",
    descripcion: "Simulacros de speaking y redacción creativa aplicada a contextos reales.",
    imagen: null
  },
  {
    mes: "Abril",
    titulo: "Próximamente / Coming Soon",
    estado: "proximo",
    tag: "Especial Primavera",
    descripcion: "Actividades al aire libre aprovechando nuestro entorno campestre.",
    imagen: null
  },
  {
    mes: "Mayo",
    titulo: "Próximamente / Coming Soon",
    estado: "proximo",
    tag: "Recta Final",
    descripcion: "Repasos intensivos y proyectos prácticos de cierre de curso.",
    imagen: null
  },
  {
    mes: "Junio",
    titulo: "Próximamente / Coming Soon",
    estado: "proximo",
    tag: "Cierre y Evaluación",
    descripcion: "Entrega de logros, presentaciones finales de los alumnos y fiesta de despedida.",
    imagen: null
  }
];
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Actualizaciones y Proyecto del Mes - SUNNE ACADEMY</title>
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    </head>
    
    <body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen" style="font-family: 'Inter', sans-serif;">

        <!-- NAVBAR -->
        <nav class="bg-yellow-200 shadow-sm sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
                <a href="/" class="flex items-center gap-3">
                    <Image 
                        src={logosune} 
                        alt="Logo SUNNE ACADEMY" 
                        class="h-16 w-auto object-contain"
                    />
                </a>
                <div class="space-x-4">
                    <a href="/servicios/niveles" class="text-sm font-semibold text-slate-700 hover:text-orange-600 transition">Niveles</a>
                    <a href="/servicios/metodologia-instalaciones" class="text-sm font-semibold text-slate-700 hover:text-orange-600 transition">Instalaciones</a>
                    <a href="/#contacto" class="text-sm font-semibold text-slate-700 hover:text-orange-600 transition">Contacto</a>
                    <a href="/" class="text-sm font-semibold text-orange-600 hover:underline">← Inicio</a>
                </div>
            </div>
        </nav>

        <main class="max-w-7xl mx-auto px-6 py-16 flex-grow space-y-16">

            <!-- HERO SECCIÓN -->
            <div class="text-center max-w-3xl mx-auto space-y-4">
                <span class="inline-flex items-center rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700 ring-1 ring-inset ring-orange-600/10">
                    Calendario del Curso Escolar
                </span>
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-950 tracking-tight leading-tight">
                    Actualizaciones & <span class="text-orange-600">Proyecto del Mes</span>
                </h1>
                <p class="text-lg text-slate-600">
                    Cada mes desarrollamos una iniciativa especial, taller práctico o actividad temática con nuestros estudiantes para mantener vivo el interés y la motivación.
                </p>
            </div>

            <!-- GRID TIPO CALENDARIO DE MESES -->
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
                {proyectosMes.map((item) => (
                    <div class="bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
                        
                        <!-- CONTENEDOR FOTO / COMING SOON -->
                        <div class="relative h-56 bg-slate-100 flex items-center justify-center overflow-hidden">
                            {item.imagen ? (
                                <Image 
                                    src={item.imagen} 
                                    alt={item.titulo} 
                                    class="w-full h-full object-cover"
                                />
                            ) : (
                                <div class="w-full h-full bg-gradient-to-br from-slate-100 to-slate-200 flex flex-col items-center justify-center p-6 text-center border-b border-slate-100">
                                    <span class="text-4xl mb-2">✨</span>
                                    <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Próximamente</span>
                                    <span class="text-lg font-bold text-slate-500 mt-1">Coming Soon</span>
                                </div>
                            )}

                            <!-- BADGE MES EN LA ESQUINA -->
                            <div class="absolute top-4 left-4 bg-slate-900/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-xl shadow">
                                {item.mes}
                            </div>

                            <!-- BADGE ESTADO -->
                            <div class="absolute top-4 right-4">
                                {item.estado === 'activo' && (
                                    <span class="bg-orange-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow">
                                        En Curso
                                    </span>
                                )}
                                {item.estado === 'completado' && (
                                    <span class="bg-emerald-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow">
                                        Completado
                                    </span>
                                )}
                            </div>
                        </div>

                        <!-- CONTENIDO TEXTO -->
                        <div class="p-6 flex flex-col justify-between flex-grow space-y-4">
                            <div>
                                <span class="text-xs font-semibold text-orange-600 tracking-wide uppercase">
                                    {item.tag}
                                </span>
                                <h3 class="text-xl font-bold text-slate-900 mt-1">
                                    {item.titulo}
                                </h3>
                                <p class="text-slate-600 text-xs mt-2 leading-relaxed">
                                    {item.descripcion}
                                </p>
                            </div>

                            <div class="pt-2 border-t border-slate-50 flex items-center justify-between text-xs text-slate-500">
                                <span>Edición 2026/27</span>
                                <span class="font-medium text-orange-600">SUNNE ACADEMY</span>
                            </div>
                        </div>

                    </div>
                ))}
            </section>

            <!-- CALL TO ACTION -->
            <section class="bg-slate-900 text-white rounded-3xl p-10 text-center space-y-6">
                <h2 class="text-3xl font-bold">¿Tienes alguna propuesta o duda sobre los talleres?</h2>
                <p class="text-slate-300 max-w-xl mx-auto text-sm">
                    Los proyectos mensuales están abiertos tanto a alumnos matriculados como a participantes externos según el aforo.
                </p>
                <div>
                    <a href="/#contacto" class="inline-block bg-orange-600 hover:bg-orange-500 text-white font-semibold px-8 py-4 rounded-xl transition shadow-lg">
                        Consultar Participación
                    </a>
                </div>
            </section>

        </main>

        <!-- FOOTER -->
        <footer class="bg-slate-950 text-slate-400 py-8 text-center text-sm border-t border-slate-900">
            <p>&copy; SUNNE ACADEMY. Todos los derechos reservados.</p>
        </footer>

        <style>
            @import "tailwindcss";
        </style>

    </body>
</html>