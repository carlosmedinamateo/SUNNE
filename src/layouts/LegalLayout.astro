---
const { frontmatter } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{frontmatter.title} - SUNNE ACADEMY</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    </head>
    <body class="bg-slate-50 text-slate-800 font-sans leading-relaxed min-h-screen flex flex-col justify-between" style="font-family: 'Inter', sans-serif;">
        
        <header class="bg-white border-b border-slate-200 py-6">
            <div class="max-w-4xl mx-auto px-6 flex justify-between items-center">
                <span class="text-xl font-bold text-orange-600">SUNNE <span class="text-slate-900">ACADEMY</span></span>
                <a href="/" class="text-sm font-semibold text-slate-600 hover:text-orange-600 transition">← Volver al Inicio</a>
            </div>
        </header>

        <main class="max-w-4xl mx-auto px-6 py-12 bg-white rounded-2xl shadow-sm border border-slate-100 my-10 prose prose-slate">
            <slot />
        </main>

        <footer class="bg-slate-950 text-slate-400 py-6 text-center text-xs">
            <p>&copy; SUNNE ACADEMY. Todos los derechos reservados.</p>
        </footer>

        <style>
            @import "tailwindcss";
        </style>
    </body>
</html>